<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mv="using:MarkView.Avalonia"
             xmlns:vm="using:BonsaiLLM.App.ViewModels"
             x:Class="BonsaiLLM.App.Views.MarkdownMessageView"
             x:DataType="vm:ChatMessageViewModel">

  <Border Classes="bubble" Classes.user="{Binding IsUser}">
    <Panel>
      <!-- 用户消息按纯文本显示，避免自己输入的 * 被当 Markdown -->
      <TextBlock Text="{Binding Text}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding IsUser}" />

      <!-- MarkdownViewer 在自适应宽度容器里测量为 0，必须由外部给满宽度 -->
      <mv:MarkdownViewer Name="PART_Viewer"
                         IsVisible="{Binding !IsUser}" />
    </Panel>
  </Border>

</UserControl>
