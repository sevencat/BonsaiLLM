<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BonsaiLLM.App.ViewModels"
        xmlns:views="using:BonsaiLLM.App.Views"
        x:Class="BonsaiLLM.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BonsaiLLM"
        Width="1080"
        Height="760"
        FontSize="{Binding FontSize}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Background" Value="#F5F6F8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.bubble.user">
      <Setter Property="Background" Value="#E4E8FF" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="MaxWidth" Value="820" />
    </Style>

    <Style Selector="Border.composer">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="#E5E7EB" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B7280" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ListBox.sessionList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.sessionList ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="236,*">

    <!-- 会话侧栏 -->
    <Border Grid.Column="0" Background="#FAFAFB" BorderThickness="0,0,1,0" BorderBrush="#E5E7EB">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,14">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Text="会话" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="新建"
                  FontSize="12"
                  Padding="10,2"
                  Command="{Binding NewSessionCommand}" />
        </Grid>

        <ListBox Grid.Row="1"
                 Classes="sessionList"
                 Margin="0,10"
                 ItemsSource="{Binding Sessions}"
                 SelectedItem="{Binding CurrentSession}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionItemViewModel">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Spacing="6">
          <TextBox Text="{Binding SessionTitleDraft}"
                   PlaceholderText="会话名称"
                   FontSize="12"
                   KeyDown="OnRenameKeyDown" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button Content="重命名"
                    FontSize="12"
                    HorizontalAlignment="Stretch"
                    Command="{Binding RenameSessionCommand}" />
            <Button Grid.Column="1"
                    Content="删除"
                    FontSize="12"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeleteCurrentSessionCommand}" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 右侧主区 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <!-- 顶栏：状态 / 模型选择 / 上下文模式 / 操作 -->
      <Border Grid.Row="0" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="BonsaiLLM" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusText}" Classes="muted" MaxWidth="300" />
            </StackPanel>

            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      MaxWidth="520"
                      PlaceholderText="选择模型"
                      ItemsSource="{Binding Models}"
                      SelectedItem="{Binding SelectedModel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelItemViewModel">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="重新扫描" Command="{Binding RescanCommand}" />
              <Button Content="设置" Command="{Binding ToggleSettingsCommand}" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <ComboBox Grid.Column="0"
                      MinWidth="140"
                      ItemsSource="{Binding ContextModeOptions}"
                      SelectedItem="{Binding SelectedContextMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContextModeOption">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Column="2"
                       Text="{Binding StatsText}"
                       Classes="muted"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
          </Grid>

          <ProgressBar Grid.Row="2"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding LoadProgress}"
                       IsVisible="{Binding IsBusy}"
                       Height="3" />
        </Grid>
      </Border>

      <!-- 对话区 -->
      <ScrollViewer Grid.Row="1" Name="ChatScroll" Padding="20,12" IsVisible="{Binding !IsEmptyVisible}">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <StackPanel>
                <views:MarkdownMessageView />
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            Margin="6,-4,0,6"
                            IsVisible="{Binding IsAssistant}">
                  <Button Content="复制"
                          FontSize="11"
                          Padding="8,1"
                          Tag="{Binding}"
                          Click="OnCopyMessage" />
                  <Button Content="重新生成"
                          FontSize="11"
                          Padding="8,1"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RegenerateCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="删除"
                          FontSize="11"
                          Padding="8,1"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteMessageCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 模型已就绪 -->
      <Border Grid.Row="1" IsVisible="{Binding ShowReadyHint}" Padding="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
          <TextBlock Text="模型已就绪"
                     FontSize="18"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="在下面输入消息开始对话"
                     Classes="muted"
                     FontSize="13"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 空状态 -->
      <Border Grid.Row="1" IsVisible="{Binding IsEmptyVisible}" Padding="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="10">
          <TextBlock Text="{Binding EmptyTitle}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyHint}"
                     Classes="muted"
                     FontSize="13"
                     TextAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="添加模型目录" Command="{Binding AddDirectoryCommand}" />
            <Button Content="打开设置" Command="{Binding ToggleSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 输入区 -->
      <Border Grid.Row="2" Classes="composer">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBox Grid.Column="0"
                   Name="Composer"
                   Text="{Binding InputText}"
                   PlaceholderText="输入消息，回车发送"
                   AcceptsReturn="False"
                   IsEnabled="{Binding CanChat}"
                   KeyDown="OnInputKeyDown" />

          <Button Grid.Column="1"
                  Content="发送"
                  Command="{Binding SendCommand}"
                  IsVisible="{Binding !IsStreaming}" />

          <Button Grid.Column="2"
                  Content="停止"
                  Command="{Binding StopCommand}"
                  IsVisible="{Binding IsStreaming}" />
        </Grid>
      </Border>
    </Grid>

    <!-- 设置面板 -->
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding IsSettingsOpen}"
            Background="#66000000">
      <Border Width="580"
              MaxHeight="660"
              CornerRadius="16"
              Background="White"
              Padding="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="0 12 40 0 #40000000">
        <ScrollViewer>
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="关闭" Command="{Binding CloseSettingsCommand}" />
            </Grid>

            <TextBlock Text="推理后端" Classes="section" />
            <ComboBox ItemsSource="{Binding BackendOptions}"
                      SelectedItem="{Binding SelectedBackend}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BackendOption">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Note}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SettingsNotice}"
                       Classes="muted"
                       Foreground="#B45309"
                       Margin="0,4,0,0" />

            <TextBlock Text="显卡" Classes="section" />
            <TextBlock Text="{Binding GpuSummary}" Classes="muted" FontSize="13" />

            <TextBlock Text="系统提示词" Classes="section" />
            <TextBox Text="{Binding SystemPrompt}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"
                     PlaceholderText="加载模型后可编辑，保存到该模型的配置里" />

            <TextBlock Text="当前模型参数" Classes="section" />
            <Grid ColumnDefinitions="*,12,*"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="8"
                  IsEnabled="{Binding HasModel}">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                <TextBlock Text="GPU 层数（0 = 纯 CPU）" Classes="muted" />
                <TextBox Text="{Binding ProfileGpuLayersText}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                <TextBlock Text="上下文长度（token）" Classes="muted" />
                <TextBox Text="{Binding ProfileContextSizeText}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                <TextBlock Text="温度（0–2）" Classes="muted" />
                <TextBox Text="{Binding ProfileTemperatureText}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                <TextBlock Text="最大 token（-1 不限）" Classes="muted" />
                <TextBox Text="{Binding ProfileMaxTokensText}" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsEnabled="{Binding HasModel}">
              <Button Content="保存参数" Command="{Binding SaveProfileCommand}" />
              <Button Content="重新加载模型" Command="{Binding ReloadModelCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ProfileNotice}"
                       Classes="muted"
                       Foreground="#B45309"
                       Margin="0,4,0,0" />

            <TextBlock Text="字号" Classes="section" />
            <Slider Minimum="12"
                    Maximum="20"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding FontSize}"
                    Width="220"
                    HorizontalAlignment="Left" />

            <TextBlock Text="模型目录" Classes="section" />
            <ItemsControl ItemsSource="{Binding ModelDirectories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontSize="13" />
                    <Button Grid.Column="1"
                            Content="移除"
                            FontSize="12"
                            Padding="8,2"
                            Tag="{Binding}"
                            Click="OnRemoveDirectoryClick" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="添加目录" Command="{Binding AddDirectoryCommand}" />
              <Button Content="重新扫描" Command="{Binding RescanCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding SettingsFilePath}" Classes="muted" Margin="0,16,0,0" />
            <TextBlock Text="{Binding SessionsDirectory}" Classes="muted" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

  </Grid>

</Window>
