<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BonsaiLLM.App.ViewModels"
        x:Class="BonsaiLLM.App.Views.LogWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="运行日志"
        Icon="/Assets/logo.png"
        Width="860"
        Height="540"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16,12,16,10">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="运行日志"
                 FontWeight="SemiBold"
                 FontSize="13"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{Binding LogSummary}"
                 Classes="muted"
                 VerticalAlignment="Center" />
      <Button Grid.Column="2"
              Content="复制"
              FontSize="11"
              Padding="10,2"
              Command="{Binding CopyLogsCommand}" />
      <Button Grid.Column="3"
              Content="清空"
              FontSize="11"
              Padding="10,2"
              Command="{Binding ClearLogsCommand}" />
      <Button Grid.Column="4"
              Content="关闭"
              FontSize="11"
              Padding="10,2"
              Click="OnCloseClick" />
    </Grid>

    <Border Grid.Row="1"
            Margin="0,10,0,0"
            Background="#FBFBFC"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">
      <ScrollViewer Name="LogScroll" Padding="10,8">
        <ItemsControl ItemsSource="{Binding Logs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogEntryViewModel">
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,1">
                <TextBlock Text="{Binding TimeText}"
                           FontFamily="Consolas,monospace"
                           FontSize="11"
                           Foreground="#9CA3AF" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LevelText}"
                           FontFamily="Consolas,monospace"
                           FontSize="11"
                           Foreground="{Binding Foreground}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Message}"
                           FontFamily="Consolas,monospace"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{Binding Foreground}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2"
               Text="只保留最近 500 条记录"
               Classes="muted"
               FontSize="11"
               Margin="0,8,0,0" />
  </Grid>
</Window>
